declare-option -hidden str-list last_command

define-command -hidden run_cmd -params .. %{
    kakpipe -n %arg{1} %arg{@}
}

define-command -hidden run_cmd_bg -params .. %{
    kakpipe-bg -n %arg{1} %arg{@}
}

define-command -docstring 'run command in fifo' cmd -params .. %{
    run_cmd %arg{@}
    set-option global last_command %arg{@}
    set-option buffer filetype cmd
}

define-command -docstring 'run command in fifo (background buffer)' cmd-bg -params .. %{
    run_cmd_bg %arg{@}
    set-option global last_command %arg{@}
    set-option buffer filetype cmd
}

define-command -docstring 'rerun last command' rcmd %{
    cmd %opt{last_command}
}

define-command -docstring 'rerun last command in background' rcmd-bg %{
    cmd-bg %opt{last_command}
}

define-command -hidden cmd-jump %{
    evaluate-commands -save-regs a %{
        try %{
            execute-keys 'ght<ret>"ay'
            evaluate-commands -try-client %opt{jumpclient} -verbatim -- edit -existing -- %reg{a}
            try %{ focus %opt{jumpclient} }
        } catch %{
            jump
        }
    }
}

hook -group cmd-highlight global WinSetOption filetype=cmd %{
    add-highlighter window/cmd group
    add-highlighter window/cmd/location regex "^([^:\n]+):(\d+):(\d+)?" 1:cyan 2:green 3:green
    add-highlighter window/cmd/path regex "^([^:\n]+[^/])$" 1:cyan
    add-highlighter window/cmd/ line %{%opt{jump_current_line}} default+b
    hook -once -always window WinSetOption filetype=.* %{ remove-highlighter window/cmd }
}

hook global WinSetOption filetype=cmd %{
    hook buffer -group cmd-hooks NormalKey <ret> cmd-jump
    hook -once -always window WinSetOption filetype=.* %{ remove-hooks buffer cmd-hooks }
}

define-command fzf-buffer -docstring 'Invoke fzf to select a buffer' %{
    evaluate-commands %sh{
        tmux split-window -l 20% "(printf \"%s\n\" $kak_quoted_buflist | fzf --bind 'focus:execute-silent(echo \"eval -client $kak_client %{ e {} }\" | kak -p $kak_session)' || echo \"$kak_buffile\") | xargs -I{} echo \"eval -client $kak_client %{ e '{}' }\" | /usr/bin/kak -p $kak_session"
    }
}

define-command -docstring 'Print Working Directory' -params 0 pwd %{
    evaluate-commands echo %sh{ echo "$(pwd)"}
}

