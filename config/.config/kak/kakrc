define-command -docstring 'git log' git-log %{
    evaluate-commands %sh{
        output=$(mktemp -d "${TMPDIR:-/tmp}"/kak-git.XXXXXXXX)/fifo
        mkfifo ${output}
        ( trap - INT QUIT; git log > ${output} 2>&1 & ) > /dev/null 2>&1 < /dev/null

        printf %s "evaluate-commands -try-client '$kak_opt_docsclient' '
                  edit! -fifo ${output} *git*
                  set-option buffer filetype git-log
                  $(hide_blame)
                  set-option buffer git_blob %{}
                  hook -always -once buffer BufCloseFifo .* ''
                      nop %sh{ rm -r $(dirname ${output}) }
                  ''
        '"
    }
}

define-command -docstring 'fd find files' -params 1 fd %{
    edit %arg{1}
}

complete-command -menu fd shell-script-candidates 'fd -I -t f .'

declare-option -hidden str last_command

define-command -docstring 'compile a la emacs' compile %{
    prompt -init "%opt{last_command}" -shell-completion "Command: " compile_text
}

define-command -docstring 'compile_text' compile_text -hidden %{
    evaluate-commands %{
        evaluate-commands -try-client %opt{toolsclient} %{
            fifo -scroll -name *compile-mode* -script %{
                trap - INT QUIT
                printf "*compilation started at $(date)*\n"
                eval "$kak_quoted_text"
                exit_code=$?
                if [ $exit_code == 0 ]; then
                    printf "*compilation finished at $(date)*\n"
                else
                    printf "*compilation exited abnormally at $(date) with exit code $exit_code*\n"
                fi
            } -- %arg{@}
            set-option buffer filetype cmd
            set-option buffer jump_current_line 0
            set-option global last_command %val{text}
        }
    }
}

define-command -docstring 'compile_run' compile_run -params .. -hidden %{
    evaluate-commands -save-regs ab %{
        set-register a %arg{@}
        set-register b %sh{ printf "*%s*" "$1" }
        evaluate-commands -try-client %opt{toolsclient} %{
            fifo -name %reg{b} -script %{
                trap - INT QUIT
                eval "$kak_quoted_reg_a"
            } -- %arg{@}
        }
    }
}

define-command -hidden cmd-jmp %{
    evaluate-commands -save-regs a %{
        try %{
            execute-keys -draft 'ght<ret>"ay'
            evaluate-commands -try-client %opt{jumpclient} -verbatim -- edit -existing -- %reg{a}
            try %{ focus %opt{jumpclient} }
        } catch %{
            jump
        }
    }
}

hook -group cmd-highlight global WinSetOption filetype=cmd %{
    add-highlighter window/cmd group
    add-highlighter window/cmd/path regex "^([^:\n\*]+[^/:])$" 1:cyan
    add-highlighter window/cmd/num-path regex "^([^:\n\*]+):(\d+):(\d+)?" 1:cyan 2:green 3:green
    add-highlighter window/cmd/error regex "^([^:\n\*]+):(\d+):(?:(\d+):)?\h+(?:((?:fatal )?error)|(warning)|(note)|(required from(?: here)?))?.*?$" 1:cyan 2:green 3:green 4:red 5:yellow 6:blue 7:yellow
    add-highlighter window/cmd/extra regex "^\h*(~*(?:(\^)~*)?)$" 1:green 2:cyan+b
    add-highlighter window/cmd/info-error regex "(\*compilation exited abnormally at .+ with exit code )([0-9]+)(\*)" 1:default+b 2:red+b 3:default+b
    add-highlighter window/cmd/info regex "^(\*[^\n]+\*)$" 1:default+b
    add-highlighter window/cmd/ line %{%opt{jump_current_line}} default+b
    hook -once -always window WinSetOption filetype=.* %{ remove-highlighter window/cmd}
}

hook global WinSetOption filetype=cmd %{
    hook buffer -group cmd-hooks NormalKey <ret> cmd-jmp
    hook -once -always window WinSetOption filetype=.* %{ remove-hooks buffer cmd-hooks }
}

declare-option str curpath_dirls %sh{pwd}

define-command dirls -params 1 %{
    set-option global curpath_dirls "%opt{curpath_dirls}/%arg{1}"
    compile_run ls -lh %opt{curpath_dirls}
    set-option buffer filetype dirls
}

complete-command dirls file 0

define-command -hidden dirls-jmp %{
    evaluate-commands -save-regs ab %{
        try %{
            execute-keys 'gl<a-t> "ay'
            evaluate-commands -try-client %opt{jumpclient} -verbatim -- edit -existing -- %reg{a}
            try %{ focus %opt{jumpclient} }
        } catch %{
            execute-keys 'gl<a-t> "ay'
            dirls %reg{a}
        }
    }
}

define-command -hidden dirls-jmp-up %{
    dirls ".."
}

hook -group dirls-highlight global WinSetOption filetype=dirls %{
    add-highlighter window/dirls group
    add-highlighter window/dirls/file regex "^(-[^\n]+)$" 1:cyan
    add-highlighter window/dirls/folder regex "^(d[^\n]+)$" 1:blue
    add-highlighter window/dirls/ line %{%opt{jump_current_line}} default+b
    hook -once -always window WinSetOption filetype=.* %{ remove-highlighter window/dirls}
}

hook global WinSetOption filetype=dirls %{
    hook buffer -group dirls-hooks NormalKey <ret> dirls-jmp
    hook buffer -group dirls-hooks NormalKey <minus> dirls-jmp-up
}

